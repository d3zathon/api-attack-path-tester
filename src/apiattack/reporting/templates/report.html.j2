<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>API Attack-Path & Authorization Test Report</title>
<style>
  :root {
    --bg: #0b0d12; --panel: #12151c; --border: #232838; --text: #dfe4ee; --muted: #8b93a7;
    --crit: #ff5470; --high: #ff9f43; --med: #ffd23f; --low: #46c2ff; --info: #7c8899;
    --ok: #35d07f;
  }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font-family: -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; padding: 2.5rem; line-height: 1.55; }
  h1 { font-size: 1.6rem; margin-bottom: .25rem; }
  h2 { border-bottom: 1px solid var(--border); padding-bottom: .4rem; margin-top: 2.5rem; }
  .meta { color: var(--muted); font-size: .9rem; margin-bottom: 2rem; }
  .meta span { display: inline-block; margin-right: 1.5rem; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
  .badge { display: inline-block; padding: .15rem .55rem; border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .sev-critical { background: rgba(255,84,112,.15); color: var(--crit); border: 1px solid var(--crit); }
  .sev-high { background: rgba(255,159,67,.15); color: var(--high); border: 1px solid var(--high); }
  .sev-medium { background: rgba(255,210,63,.15); color: var(--med); border: 1px solid var(--med); }
  .sev-low { background: rgba(70,194,255,.15); color: var(--low); border: 1px solid var(--low); }
  .sev-info { background: rgba(124,136,153,.15); color: var(--info); border: 1px solid var(--info); }
  .status-confirmed { color: var(--ok); font-weight: 600; }
  .status-unverified { color: var(--muted); font-weight: 600; }
  code, pre { font-family: "SF Mono", Consolas, monospace; font-size: .85rem; }
  pre { background: #090a0e; border: 1px solid var(--border); border-radius: 8px; padding: .9rem; overflow-x: auto; white-space: pre-wrap; word-break: break-word; }
  details summary { cursor: pointer; color: var(--muted); margin-top: .75rem; }
  .steps ol { padding-left: 1.2rem; }
  .finding-title { font-size: 1.05rem; font-weight: 700; margin: .3rem 0 .6rem; }
  .kv { color: var(--muted); font-size: .85rem; margin-bottom: .4rem; }
  .kv b { color: var(--text); }
  footer { color: var(--muted); font-size: .8rem; margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1rem; }
</style>
</head>
<body>
  <h1>API Attack-Path & Authorization Test Report</h1>
  <div class="meta">
    <span><b>Target:</b> {{ result.target }}</span>
    <span><b>Roles:</b> {{ result.roles_tested | join(", ") }}</span>
    <span><b>Endpoints:</b> {{ result.endpoints_tested }} / {{ result.endpoints_discovered }}</span>
    <span><b>Confirmed:</b> {{ confirmed | length }} / {{ findings | length }}</span>
  </div>

  {% if result.attack_paths %}
  <h2>Attack Paths</h2>
  {% for ap in result.attack_paths %}
  <div class="card">
    <span class="badge sev-{{ ap.severity.value }}">{{ ap.severity.value }}</span>
    <div class="finding-title">{{ ap.title }}</div>
    <div class="kv"><b>Starting role:</b> {{ ap.starting_role }}</div>
    <div class="kv">{{ ap.impact }}</div>
    <div class="steps"><ol>
      {% for step in ap.steps %}<li>{{ step.description }} <code>({{ step.finding_id }})</code></li>{% endfor %}
    </ol></div>
  </div>
  {% endfor %}
  {% endif %}

  <h2>Findings</h2>
  {% for f in findings %}
  <div class="card">
    <span class="badge sev-{{ f.severity.value }}">{{ f.severity.value }}</span>
    <span class="{{ 'status-confirmed' if f.confirmed else 'status-unverified' }}">
      {{ "CONFIRMED" if f.confirmed else "UNVERIFIED" }} ({{ f.confidence }})
    </span>
    <div class="finding-title">{{ f.title }}</div>
    <div class="kv"><b>Class:</b> {{ f.vuln_class.value }} &nbsp; <b>OWASP:</b> {{ f.owasp_api_id or "n/a" }} &nbsp; <b>CWE:</b> {{ f.cwe or "n/a" }}</div>
    <div class="kv"><b>Endpoint:</b> <code>{{ f.endpoint }}</code></div>
    <div class="kv"><b>Actor:</b> {{ f.actor_role }}{% if f.victim_role %} &nbsp; <b>Victim:</b> {{ f.victim_role }}{% endif %}</div>
    <p>{{ f.description }}</p>
    {% if f.verification_notes %}
    <div class="kv"><b>Verification:</b></div>
    <ul>{% for note in f.verification_notes %}<li class="kv">{{ note }}</li>{% endfor %}</ul>
    {% endif %}
    <p><b>Remediation:</b> {{ f.remediation }}</p>
    <details>
      <summary>Evidence ({{ f.evidence | length }} request/response pair(s))</summary>
      {% for ev in f.evidence %}
      <pre>[{{ loop.index }}] {{ ev.description }}
{{ ev.method }} {{ ev.url }}
Status: {{ ev.status_code }}  ({{ ev.elapsed_ms }} ms)
Request body: {{ ev.request_body }}
Response excerpt:
{{ ev.response_body_excerpt }}</pre>
      {% endfor %}
    </details>
  </div>
  {% endfor %}

  <footer>
    Generated by API Attack-Path & Authorization Tester. For use only against systems you are explicitly authorized to test.
  </footer>
</body>
</html>
